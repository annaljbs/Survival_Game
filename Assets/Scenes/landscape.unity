  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interactable
  action:
    name: Build a fire
    description: Lay tinder, add kindling, then logs, and light it. Everything must
      be dry.
    minutes: 20
    energyDelta: -4
    waterDelta: 0
    foodDelta: 0
    warmthDelta: 0
    reason: Arranging a fire takes patience
    requirements:
    - item: 9
      count: 1
      consume: 1
      missingHint: Needs dry tinder (grass, bark or paper). Wet or green material
        won't catch.
    - item: 10
      count: 1
      consume: 1
      missingHint: 'Needs dry kindling: thin dead twigs. Green or wet twigs won''t
        catch.'
    - item: 11
      count: 2
      consume: 1
      missingHint: Needs 2 dry logs. Wet logs won't light.
    - item: 5
      count: 1
      consume: 0
      missingHint: Needs a lighter.
